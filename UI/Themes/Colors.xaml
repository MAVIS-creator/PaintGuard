<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette (Stitch Dark Slate) -->
    <Color x:Key="ColorBackground">#0B1326</Color>
    <Color x:Key="ColorSurface">#171F33</Color>
    <Color x:Key="ColorSurfaceHigh">#222A3D</Color>
    <Color x:Key="ColorSurfaceVariant">#2D3449</Color>
    <Color x:Key="ColorSurfaceLowest">#060E20</Color>

    <!-- Accent & Status Colors -->
    <Color x:Key="ColorPrimary">#B4C5FF</Color>
    <Color x:Key="ColorPrimaryContainer">#2563EB</Color>
    <Color x:Key="ColorSecondary">#68DBA9</Color>
    <Color x:Key="ColorSecondaryContainer">#25A475</Color>
    <Color x:Key="ColorTertiary">#FFB77D</Color>
    <Color x:Key="ColorError">#FFB4AB</Color>
    <Color x:Key="ColorOutline">#434655</Color>
    <Color x:Key="ColorTextMain">#DAE2FD</Color>
    <Color x:Key="ColorTextMuted">#C3C6D7</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceHigh" Color="{StaticResource ColorSurfaceHigh}" />
    <SolidColorBrush x:Key="BrushSurfaceVariant" Color="{StaticResource ColorSurfaceVariant}" />
    <SolidColorBrush x:Key="BrushSurfaceLowest" Color="{StaticResource ColorSurfaceLowest}" />

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{StaticResource ColorPrimaryContainer}" />
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="BrushSecondaryContainer" Color="{StaticResource ColorSecondaryContainer}" />
    <SolidColorBrush x:Key="BrushTertiary" Color="{StaticResource ColorTertiary}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushOutline" Color="{StaticResource ColorOutline}" />
    <SolidColorBrush x:Key="BrushTextMain" Color="{StaticResource ColorTextMain}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

</ResourceDictionary>
