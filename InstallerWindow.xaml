<Window x:Class="VaultGuard360.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VaultGuard 360 - Custom Installer"
        Height="620" Width="960" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        Background="#0B1326">

    <Border BorderBrush="{StaticResource BrushOutline}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <!-- Top Header & Close Button -->
            <Border Height="40" VerticalAlignment="Top" Padding="16,8" Panel.ZIndex="100">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="VaultGuard 360 Setup" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                    <Button Content="✕" Foreground="{StaticResource BrushTextMuted}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="14" Cursor="Hand" Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <!-- VIEW 1: WELCOME SCREEN (Stitch Installer Screen 1) -->
            <Grid x:Name="WelcomeView" Visibility="Visible" Margin="0,40,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="680">

                    <!-- Logo Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="🛡️" FontSize="44" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VaultGuard 360" Foreground="{StaticResource BrushPrimary}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="High-Security Antivirus &amp; Immunity Suite" Foreground="{StaticResource BrushTextMuted}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Glowing Shield Graphic -->
                    <Border Style="{StaticResource StitchCardStyle}" Width="220" Height="180" Margin="0,0,0,24" HorizontalAlignment="Center">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="120" Height="120" Stroke="{StaticResource BrushPrimary}" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="30" ShadowDepth="0" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="🛡️" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Action Button -->
                    <Button Content="⚡  INSTALL NOW" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" Padding="32,14" HorizontalAlignment="Center" Click="InstallNow_Click" Margin="0,0,0,16" />

                    <!-- Advanced Options Dropdown Toggle -->
                    <Expander Header="Advanced Installation Options" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" FontSize="12" Width="520">
                        <Border Style="{StaticResource CardInnerStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Installation Location:" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBox x:Name="InstallPathBox" Text="C:\Program Files\VaultGuard 360" Background="{StaticResource BrushSurfaceLowest}" Foreground="{StaticResource BrushTextMain}" BorderBrush="{StaticResource BrushOutline}" Padding="8" FontFamily="Consolas" FontSize="12" Margin="0,0,0,10" />

                                <CheckBox x:Name="DesktopShortcutCheck" Content="Create Desktop Shortcut" IsChecked="True" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,6" />
                                <CheckBox x:Name="StartMenuShortcutCheck" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,6" />
                                <CheckBox x:Name="AutoStartCheck" Content="Run VaultGuard 360 automatically when Windows starts" IsChecked="True" Foreground="{StaticResource BrushTextMain}" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock Text="Created by Klyvex Studios" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0" />
                </StackPanel>
            </Grid>

            <!-- VIEW 2: PROGRESS & DEPLOYMENT SEQUENCE (Stitch Installer Screen 2) -->
            <Grid x:Name="ProgressView" Visibility="Collapsed" Margin="24,50,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Main Progress Bar & Title -->
                <Border Grid.Column="0" Style="{StaticResource StitchCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🛡️" FontSize="28" Margin="0,0,10,0" />
                                <TextBlock Text="VaultGuard 360" Foreground="{StaticResource BrushPrimary}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="InstallingTitleText" Text="Installing System Protection..." Foreground="{StaticResource BrushTextMain}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Securing your digital environment. Please do not restart your computer." Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                        </StackPanel>

                        <!-- Progress Controls -->
                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Overall Progress" Foreground="{StaticResource BrushTextMain}" FontSize="13" />
                                <TextBlock x:Name="PercentText" Text="0%" Foreground="{StaticResource BrushPrimary}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
                            </DockPanel>

                            <ProgressBar x:Name="MainProgressBar" Value="0" Maximum="100" Height="14" Background="{StaticResource BrushSurfaceVariant}" Foreground="{StaticResource BrushPrimaryContainer}" BorderThickness="0" Margin="0,0,0,10" />

                            <TextBlock x:Name="StatusMessageText" Text="Preparing deployment sequence..." Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Panel: Step-by-Step Sequence -->
                <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="DEPLOYMENT SEQUENCE" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="1">
                            <!-- Step 1 -->
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="Step1Badge" Text="○" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Preparing installation" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="Step1Status" Text="PENDING" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Step 2 -->
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="Step2Badge" Text="○" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Installing core engine" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="Step2Status" Text="PENDING" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Step 3 -->
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="Step3Badge" Text="○" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Installing protection modules" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="Step3Status" Text="PENDING" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Step 4 -->
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="Step4Badge" Text="○" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Creating system services" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="Step4Status" Text="PENDING" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Step 5 -->
                            <DockPanel>
                                <TextBlock x:Name="Step5Badge" Text="○" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Configuring protection" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="Step5Status" Text="PENDING" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- Action Button on Finish -->
                        <Button x:Name="LaunchButton" Grid.Row="2" Content="🚀  LAUNCH VAULTGUARD 360 NOW" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" Click="LaunchButton_Click" HorizontalAlignment="Stretch" Padding="12" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
