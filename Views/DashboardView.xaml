<UserControl x:Class="VaultGuard360.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">

            <!-- 3-Column Bento Grid Row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Central Status Card -->
                <Border Grid.Column="0" Style="{StaticResource StitchCardStyle}" Height="340">
                    <Grid>
                        <TextBlock Text="SYS_STATE: SECURE" Foreground="{StaticResource BrushSecondary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Glowing Status Ring -->
                            <Grid Width="180" Height="180" Margin="0,0,0,16">
                                <Ellipse Stroke="{StaticResource BrushSecondary}" StrokeThickness="4">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#68DBA9" BlurRadius="25" ShadowDepth="0" Opacity="0.6" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Protected" Foreground="{StaticResource BrushTextMain}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Real-Time Engine Active" Foreground="{StaticResource BrushTextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button Content="⚡  EXECUTE QUICK SCAN NOW" Style="{StaticResource PrimaryButtonStyle}" Click="QuickScan_Click" Padding="24,12" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Real-Time Protection Card -->
                <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}" Height="340">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Real-Time Protection" Foreground="{StaticResource BrushPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource BrushSecondaryContainer}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="ACTIVE" Foreground="#00311F" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                            </Border>
                        </DockPanel>

                        <StackPanel Grid.Row="1">
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="USB Watcher" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="✓" Foreground="{StaticResource BrushSecondary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="VolumeChangeEvent: LISTEN" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardInnerStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Network Guard" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="✓" Foreground="{StaticResource BrushSecondary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="Traffic: IN/OUT SECURE" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="Port: 18443" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" />
                            <TextBlock Text="Auth: Bearer" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Security Health Card -->
                <Border Grid.Column="4" Style="{StaticResource StitchCardStyle}" Height="340">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <TextBlock Text="Security Health" Foreground="{StaticResource BrushPrimary}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="ACL_STATUS" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>

                        <StackPanel Margin="0,0,0,20">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Baseline Vault" Foreground="{StaticResource BrushTextMain}" FontSize="12" />
                                <TextBlock Text="Intact" Foreground="{StaticResource BrushSecondary}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="100" Height="8" Background="{StaticResource BrushSurfaceVariant}" Foreground="{StaticResource BrushSecondary}" BorderThickness="0" />
                            <TextBlock Text="ACL: Read-Only System, Admin Write" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Quarantine Vault" Foreground="{StaticResource BrushTextMain}" FontSize="12" />
                                <TextBlock Text="Secured" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="100" Height="8" Background="{StaticResource BrushSurfaceVariant}" Foreground="{StaticResource BrushPrimary}" BorderThickness="0" />
                            <TextBlock Text="ACL: No Execute, Admin Read/Delete" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4-Rung Remediation Tracker Card -->
            <Border Style="{StaticResource StitchCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="4-Rung Remediation Tracker" Foreground="{StaticResource BrushPrimary}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Multi-family malware neutralization engine across system drives." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Content="⚡  REMEDIATE TARGET NOW" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="Remediate_Click" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <Border Grid.Column="0" Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushSecondary}" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="STEP 1" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                <TextBlock Text="Kill Process" Foreground="{StaticResource BrushTextMain}" FontSize="13" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock Text="Terminates malware payloads in memory." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Step 2 -->
                        <Border Grid.Column="2" Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushSecondary}" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="STEP 2" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                <TextBlock Text="Vault Restore" Foreground="{StaticResource BrushTextMain}" FontSize="13" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock Text="Replaces infected binaries with clean copies." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Step 3 -->
                        <Border Grid.Column="4" Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushSecondary}" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="STEP 3" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                <TextBlock Text="SFC / DISM" Foreground="{StaticResource BrushTextMain}" FontSize="13" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock Text="Cleans infected registry run keys &amp; WMI hooks." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Step 4 -->
                        <Border Grid.Column="6" Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushSecondary}" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="STEP 4" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="10" />
                                <TextBlock Text="Alerts &amp; Traps" Foreground="{StaticResource BrushTextMain}" FontSize="13" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock Text="Deploys read-only dummy autorun.inf traps." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
