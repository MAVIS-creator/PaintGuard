<UserControl x:Class="VaultGuard360.Views.VaultManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Triple-Vault Storage &amp; Snapshot Manager" Foreground="{StaticResource BrushPrimary}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Non-destructive incident response, baseline snapshots, and isolated payload vaulting." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📸  CREATE BASELINE SNAPSHOT" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="CreateSnapshot_Click" />
                    <Button Content="🛡️  RUN EXPIRO REMEDIATION" Style="{StaticResource SecondaryButtonStyle}" Click="RunExpiroRemediation_Click" />
                </StackPanel>
            </DockPanel>

            <!-- Status Banner -->
            <Border Grid.Row="1" Style="{StaticResource CardInnerStyle}" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="⚡ STATUS:" Foreground="{StaticResource BrushSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextMain}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Main Triple-Vault Columns -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Baseline Vault -->
                <Border Grid.Column="0" Style="{StaticResource StitchCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Baseline Vault" Foreground="{StaticResource BrushPrimary}" FontSize="15" FontWeight="Bold" />
                            <Border Background="rgba(104, 219, 169, 0.1)" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="VERIFIED" Foreground="{StaticResource BrushSecondary}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Verified clean binaries &amp; SHA256 hashes." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding BaselineAssets}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,6" Padding="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextMain}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushSecondary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Hash}" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="9" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 2. Golden Vault (Self-Healing Templates) -->
                <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Golden Vault" Foreground="{StaticResource BrushSecondary}" FontSize="15" FontWeight="Bold" />
                            <Border Background="rgba(180, 197, 255, 0.1)" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="IMMUTABLE" Foreground="{StaticResource BrushPrimary}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Golden module templates for self-healing integrity." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding GoldenVaultAssets}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,6" Padding="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextMain}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushPrimary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Hash}" Foreground="{StaticResource BrushTextMuted}" FontFamily="Consolas" FontSize="9" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 3. Quarantine Vault -->
                <Border Grid.Column="4" Style="{StaticResource StitchCardStyle}" BorderBrush="{StaticResource BrushError}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Quarantine Vault" Foreground="{StaticResource BrushError}" FontSize="15" FontWeight="Bold" />
                            <Border Background="rgba(255, 180, 171, 0.1)" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="ISOLATED" Foreground="{StaticResource BrushError}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Encrypted threat payloads isolated from disk." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding QuarantinedAssets}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,6" Padding="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushError}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushError}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource BrushTextMuted}" FontSize="9" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
