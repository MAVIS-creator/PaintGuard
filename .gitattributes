# Set default behavior to automatically normalize line endings
* text=auto

# PowerShell scripts require CRLF line endings on Windows
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Web assets & documentation
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=crlf
