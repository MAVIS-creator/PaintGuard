<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>VaultGuard360_Setup</AssemblyName>
    <RootNamespace>VaultGuard360.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Klyvex Studios</Authors>
    <Company>Klyvex Studios Security Team</Company>
    <Product>VaultGuard 360 Custom Installer</Product>
    <Copyright>Copyright (c) 2026 Klyvex Studios</Copyright>
    <StartupObject>VaultGuard360.Setup.SetupApp</StartupObject>
  </PropertyGroup>

  <!-- Exclude Main Antivirus App Files from Setup Build -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="Views\**" />
    <Compile Remove="ViewModels\**" />
    <Compile Remove="Services\EngineService.cs" />
    <Compile Remove="Services\NotificationService.cs" />
    <Compile Remove="Services\UsbWatcherService.cs" />
    <Page Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
    <Page Remove="Views\**" />
  </ItemGroup>

  <!-- WPF Application Entry -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="SetupApp.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
