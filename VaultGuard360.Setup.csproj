<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>VaultGuard360_Setup</AssemblyName>
    <RootNamespace>VaultGuard360.Setup</RootNamespace>
    <StartupObject>VaultGuard360.Setup.SetupProgram</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>Klyvex Studios</Authors>
    <Company>Klyvex Studios Security Team</Company>
    <Product>VaultGuard 360 Custom Installer</Product>
    <Copyright>Copyright (c) 2026 Klyvex Studios</Copyright>
    <!-- Disable all auto-discovery to avoid conflicts with main app -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Only include setup-specific files -->
  <ItemGroup>
    <Compile Include="Services\InstallerEngineService.cs" />
    <Compile Include="SetupProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>
